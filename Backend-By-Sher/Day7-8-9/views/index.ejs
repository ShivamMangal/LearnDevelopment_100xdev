<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Local Note Taking App🦁</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-zinc-900">
    <div class="w-full min-h-screen flex items-center justify-center p-4">
      <div
        class="bg-zinc-800 w-full max-w-md p-6 rounded-2xl shadow-lg shadow-black/40 space-y-6"
      >
        <h1 class="text-white text-2xl font-semibold text-center">
          Create a New Note 📝
        </h1>

        <form action="/create" method="post" class="flex flex-col gap-4">
          <input
            name="title"
            type="text"
            placeholder="Title goes here"
            class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder-zinc-400 outline-none focus:ring-2 focus:ring-blue-500 transition"
          />

          <textarea
            name="content"
            placeholder="Write your task details here"
            class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder-zinc-400 h-40 outline-none focus:ring-2 focus:ring-blue-500 transition resize-none"
          ></textarea>

          <input
            type="submit"
            value="Create Task"
            class="w-full bg-blue-600 hover:bg-blue-700 transition text-white font-semibold p-3 rounded-lg cursor-pointer"
          />
        </form>

        <!-- TASKS SECTION -->
        <div class="tasks flex gap-3 flex-wrap p-3">
          <% if (files && files.length > 0) { %>

            <% files.forEach(function(file){ %>
              <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
                <h1 class="text-white text-3xl tracking-tighter">
                  <%= file.replace('.txt', '') %>
                </h1>

                <a
                  class="text-blue-500 inline-block mt-3"
                  href="/files/<%= file %>"
                >
                  Read More
                </a>
              </div>
            <% }) %>

          <% } else { %>
            <h3 class="text-zinc-600 w-full text-center">No tasks yet.</h3>
          <% } %>
        </div> 
      </div>
    </div>
  </body>
</html>
